# Optional settings. Copy to .env (gitignored) to use them. Environment variables win over this file.
# --- live preview (test_harness/core/orchistraitor/f1_multiagent/harness/core/preview.ts)
# PREVIEW_PUBLIC_HOST=192.168.29.111   # host/IP a BROWSER uses for public_url (default: this machine's first LAN IPv4)
# PREVIEW_BIND=0.0.0.0                 # address the port is published on (127.0.0.1 = this machine only)
# PREVIEW_PORT_FROM=5300               # host port range for previews
# PREVIEW_PORT_TO=5399
# PREVIEW_NETWORK=                     # docker network to join; then docker_network_url is http://preview-<id>:5173 (by name)
# PREVIEW_IMAGE=agent-testing-claude:1
