{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@root/*": ["./*"],
      "@test_cases/*": ["./TestCases/*"],
      "@test_harness/*": ["./test_harness/*"],
      "@core/*": ["./test_harness/core/*"]
    }
  }
}
