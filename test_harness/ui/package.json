{
  "name": "test-agent-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel api web",
    "web": "vite",
    "api": "bun server/index.ts",
    "build": "vue-tsc --noEmit && vite build",
