+const styles = StyleSheet.create({
+  container: {
+    position: "absolute",
+    bottom: 0,
+    left: 0,
+    right: 0,
+    flexDirection: "row",
+    alignItems: "flex-end",
+    paddingHorizontal: TAB_BAR_HORIZONTAL_PADDING,
+  },
+});
