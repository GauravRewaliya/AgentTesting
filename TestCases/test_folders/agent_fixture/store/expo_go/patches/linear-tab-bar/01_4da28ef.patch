+  const tabIconOpacity = useAnimatedStyle(() => ({
+    opacity: interpolate(searchProgress.value, [0, 0.5], [1, 0]),
+  }));
+
+  const backIconOpacity = useAnimatedStyle(() => ({
+    opacity: interpolate(searchProgress.value, [0.5, 1], [0, 1]),
+  }));
