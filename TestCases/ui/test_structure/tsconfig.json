{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@root/*": [
        "../../../*"
      ],
      "@test_cases/*": [
        "../../*"
      ],
      "@test_harness/*": [
        "../../../test_harness/*"
      ],
      "@core/*": [
        "../../../test_harness/core/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "shared/**/*.ts",
    "vite.config.ts"
  ]
}